# Copy to .env locally; never commit it. Configure one AI provider.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
# openai-compatible only: AI_BASE_URL=https://api.openai.com/v1
# ollama only: OLLAMA_BASE_URL=http://127.0.0.1:11434
GITHUB_PROJECT_REPO=
GITHUB_PROJECT_TOKEN=

# Public production HTTPS origin, without a path (leave blank for private staging)
PUBLIC_SITE_URL=

# Private GitHub data repository (initialize with README before first launch).
GITHUB_DATA_REPO=
GITHUB_DATA_TOKEN=
# Explicit first-time consent to upload existing local data into an empty repository.
GITHUB_DATA_BOOTSTRAP=0
# DATA_DIR=data/ecosystem.sqlite.files
# OWNER_PASSWORD=
